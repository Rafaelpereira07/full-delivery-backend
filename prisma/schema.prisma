generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  ADMIN
}

enum StatusRestaurante {
  PENDENTE
  APROVADO
  REJEITADO
  BLOQUEADO
}

enum StatusPedido {
  PENDENTE
  ACEITO
  EM_PREPARACAO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum TipoInteracao {
  PERGUNTA
  AVALIACAO
}

enum StatusInteracao {
  ABERTA
  RESPONDIDA
  CONFIRMADA
}

model Usuario {
  id         String      @id @default(uuid())
  nome       String
  email      String      @unique
  senha      String
  telefone   String?
  endereco   String?
  role       Role        @default(CLIENTE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  pedidos    Pedido[]
  interacoes Interacao[]
}

model Restaurante {
  id             String            @id @default(uuid())
  nome           String
  responsavel    String
  email          String            @unique
  senha          String
  telefone       String
  descricao      String?           @db.Text
  endereco       String
  status         StatusRestaurante @default(PENDENTE)
  motivoRejeicao String?           @db.Text
  decididoEm     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  produtos       Produto[]
  pedidos        Pedido[]

  @@index([status])
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  produtos Produto[]
}

model Produto {
  id             String       @id @default(uuid())
  nome           String
  descricao      String?      @db.Text
  preco          Decimal      @db.Decimal(10, 2)
  imagem         String?      @db.VarChar(500)
  disponivel     Boolean      @default(true)
  destaque       Boolean      @default(false)
  iaCuriosidade  String?      @db.Text
  iaHarmonizacao String?      @db.Text
  iaGeradoEm     DateTime?
  restauranteId  String
  categoriaId    Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  restaurante    Restaurante  @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  categoria      Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itensPedido    ItemPedido[]
  interacoes     Interacao[]

  @@index([restauranteId])
  @@index([categoriaId])
  @@index([destaque])
}

model Pedido {
  id              String       @id @default(uuid())
  clienteId       String
  restauranteId   String
  status          StatusPedido @default(PENDENTE)
  valorTotal      Decimal      @db.Decimal(10, 2)
  enderecoEntrega String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  cliente         Usuario      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  restaurante     Restaurante  @relation(fields: [restauranteId], references: [id], onDelete: Restrict)
  itens           ItemPedido[]

  @@index([clienteId])
  @@index([restauranteId])
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      String
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
}

model Interacao {
  id           String          @id @default(uuid())
  tipo         TipoInteracao
  mensagem     String          @db.Text
  nota         Int?
  resposta     String?         @db.Text
  respondidaEm DateTime?
  status       StatusInteracao @default(ABERTA)
  usuarioId    String
  produtoId    String
  createdAt    DateTime        @default(now())
  usuario      Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto      Produto         @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([produtoId])
}
